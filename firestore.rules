rules_version = '2';

/**
 * ==============================================================================
 * SWASTHYASETU CLOUD FIRESTORE SECURITY RULES
 * ==============================================================================
 *
 * ARCHITECTURAL PRINCIPLES:
 * 1. Restrictive Default: All direct client read/write access is denied by default.
 * 2. Server-Side Data Boundary: Consequential domain collections (households,
 *    members, schemes, rules, gaps, evidence, actions, followups, audit logs)
 *    are managed EXCLUSIVELY by the Fastify Node.js backend using Firebase Admin SDK.
 * 3. Client Firebase SDK is restricted to authenticated user profile/consent operations.
 * 4. NEVER use `allow read, write: if true;` in any environment.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all posture
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated User Profiles (Phase 2 Foundation)
    match /users/{userId} {
      // Only the authenticated user can read or update their own profile metadata
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'phoneNumber', 'role', 'updatedAt']);
      allow delete: if false;
    }

    // User Notifications (Phase 2 Foundation)
    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Notifications are written solely by backend services
    }

    // Core Domain Collections (Server-Only Access via Firebase Admin SDK)
    // Direct client access is explicitly disallowed:
    // - /households/{householdId}
    // - /members/{memberId}
    // - /schemes/{schemeId}
    // - /scheme_rules/{ruleId}
    // - /documents/{documentId}
    // - /gaps/{gapId}
    // - /evidence/{evidenceId}
    // - /actions/{actionId}
    // - /followups/{followupId}
    // - /audit_logs/{logId}
  }
}
