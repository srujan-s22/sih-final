rules_version = '2';

/**
 * ==============================================================================
 * SWASTHYASETU CLOUD FIRESTORE SECURITY RULES
 * ==============================================================================
 *
 * ARCHITECTURAL PRINCIPLES:
 * 1. Restrictive Default: All direct client read/write access is denied by default.
 * 2. Server-Side Data Boundary: Consequential domain collections (households,
 *    members, schemes, rules, gaps, evidence, actions, followups, audit logs,
 *    role assignments) are managed EXCLUSIVELY by the Fastify Node.js backend
 *    using the Firebase Admin SDK.
 * 3. Role Security: Clients CANNOT write or mutate the `role` field.
 * 4. NEVER use `allow read, write: if true;` in any environment.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all posture
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated User Profiles (Phase 2 Identity & Consent)
    match /users/{userId} {
      // Authenticated users can read their own profile document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Clients may ONLY update safe presentation metadata (displayName, phoneNumber, updatedAt)
      // Client writes to `role`, `consentStatus`, `consentVersion`, `consentedAt` are strictly FORBIDDEN
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'updatedAt']);
        
      // Client-side document creation & deletion are forbidden; managed by backend sync
      allow create, delete: if false;

      // Consent History Subcollection (Audit Trail)
      match /consent_history/{consentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Written exclusively by backend UserService
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Written exclusively by backend NotificationService
      }
    }

    // Core Domain Collections (Server-Only Access via Firebase Admin SDK)
    // Direct client access is explicitly disallowed:
    // - /households/{householdId}
    // - /members/{memberId}
    // - /schemes/{schemeId}
    // - /scheme_rules/{ruleId}
    // - /documents/{documentId}
    // - /gaps/{gapId}
    // - /evidence/{evidenceId}
    // - /actions/{actionId}
    // - /followups/{followupId}
    // - /audit_logs/{logId}
  }
}
