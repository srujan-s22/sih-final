# ==============================================================================
# SWASTHYASETU BACKEND ENVIRONMENT CONFIGURATION (NODE.JS + FASTIFY)
# ==============================================================================

# ==============================================================================
# 1. CORE & FIREBASE CONFIGURATION (PHASE 1–5)
# ==============================================================================

# Environment (development | test | staging | production)
NODE_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000
API_BASE_PATH=/api

# CORS Allowed Origins (comma-separated list, NO wildcard "*" in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin Configuration (Server-Side Only)
FIREBASE_PROJECT_ID=
# Option A (Local Dev): Path to service-account JSON file (must NEVER be committed)
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_CREDENTIALS_PATH=
# Option B (Production/Render): Raw credentials stored in secret manager
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ==============================================================================
# 2. PHASE 6 — EVIDENCE & TAVILY INTEGRATION (SERVER-SIDE ONLY)
# ==============================================================================
# Tavily API Key (Never expose to frontend / NEXT_PUBLIC_*)
TAVILY_API_KEY=
EVIDENCE_CACHE_TTL_HOURS=72
EVIDENCE_MAX_SEARCH_RESULTS=3
EVIDENCE_REQUEST_TIMEOUT_MS=10000

# ==============================================================================
# 3. PHASE 7 — LYZR AI INTELLIGENCE LAYER (SERVER-SIDE ONLY)
# ==============================================================================
# Lyzr Agent API Key (Never expose to frontend / NEXT_PUBLIC_*)
LYZR_API_KEY=
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_AGENT_ID=swasthyasetu-intelligence-agent
LYZR_TIMEOUT_MS=15000
LYZR_ANONYMIZATION_SECRET=
AI_CACHE_TTL_HOURS=24

# ==============================================================================
# 4. PRIVILEGED ACCOUNT PROVISIONING (SERVER-SIDE ONLY)
# ==============================================================================
# SHA-256 hashes of the registration secrets required to provision ASHA or ADMIN accounts.
# Generate hash using: npx tsx scripts/generate-secret-hash.ts <secret>
# If unconfigured, privileged registration fails closed.
ASHA_REGISTRATION_SECRET_HASH=
ADMIN_REGISTRATION_SECRET_HASH=

# ==============================================================================
# 5. PHASE 8 — GEMINI CONVERSATIONAL ASSISTANT (SERVER-SIDE ONLY)
# ==============================================================================
# Google Gemini API Key (Never expose to frontend / NEXT_PUBLIC_*)
# If unconfigured, the assistant fails gracefully with 503 without crashing the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=2048

# ==============================================================================
# 6. FUTURE PHASE VARIABLES (PHASE 9+)
# ==============================================================================
# N8N_WEBHOOK_URL=
# SARVAM_API_KEY=
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# SWYTCHCODE_API_KEY=

