# ==============================================================================
# SWASTHYASETU BACKEND ENVIRONMENT CONFIGURATION (NODE.JS + FASTIFY)
# ==============================================================================

# ==============================================================================
# 1. CURRENTLY REQUIRED (PHASE 1)
# ==============================================================================

# Environment (development | test | staging | production)
NODE_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000
API_BASE_PATH=/api

# CORS Allowed Origins (comma-separated list, NO wildcard "*" in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin Configuration (Server-Side Only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option A (Local Dev): Path to service-account JSON file (must NEVER be committed)
FIREBASE_CREDENTIALS_PATH=
# Option B (Production/Render): Raw service-account JSON string stored in secret manager
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==============================================================================
# 2. FUTURE PHASE VARIABLES (DO NOT CONFIGURE IN PHASE 1)
# ==============================================================================
# GEMINI_API_KEY=
# LYZR_API_KEY=
# TAVILY_API_KEY=
# N8N_WEBHOOK_URL=
# SARVAM_API_KEY=
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# SWYTCHCODE_API_KEY=
