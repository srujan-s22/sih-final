# ==============================================================================
# SWASTHYASETU BACKEND ENVIRONMENT CONFIGURATION (NODE.JS + FASTIFY)
# ==============================================================================

# ==============================================================================
# 1. CORE & FIREBASE CONFIGURATION (PHASE 1–5)
# ==============================================================================

# Environment (development | test | staging | production)
NODE_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000
API_BASE_PATH=/api

# CORS Allowed Origins (comma-separated list, NO wildcard "*" in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin Configuration (Server-Side Only)
FIREBASE_PROJECT_ID=
# Option A (Local Dev): Path to service-account JSON file (must NEVER be committed)
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_CREDENTIALS_PATH=
# Option B (Production/Render): Raw credentials stored in secret manager
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ==============================================================================
# 2. PHASE 6 — EVIDENCE & TAVILY INTEGRATION (SERVER-SIDE ONLY)
# ==============================================================================
# Tavily API Key (Never expose to frontend / NEXT_PUBLIC_*)
TAVILY_API_KEY=
EVIDENCE_CACHE_TTL_HOURS=72
EVIDENCE_MAX_SEARCH_RESULTS=3
EVIDENCE_REQUEST_TIMEOUT_MS=10000

# ==============================================================================
# 3. PHASE 7 — LYZR AI INTELLIGENCE LAYER (SERVER-SIDE ONLY)
# ==============================================================================
# Lyzr Agent API Key (Never expose to frontend / NEXT_PUBLIC_*)
LYZR_API_KEY=
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_AGENT_ID=swasthyasetu-intelligence-agent
LYZR_TIMEOUT_MS=15000
LYZR_ANONYMIZATION_SECRET=
AI_CACHE_TTL_HOURS=24

# ==============================================================================
# 4. PRIVILEGED ACCOUNT PROVISIONING (SERVER-SIDE ONLY)
# ==============================================================================
# SHA-256 hashes of the registration secrets required to provision ASHA or ADMIN accounts.
# Generate hash using: npx tsx scripts/generate-secret-hash.ts <secret>
# If unconfigured, privileged registration fails closed.
ASHA_REGISTRATION_SECRET_HASH=
ADMIN_REGISTRATION_SECRET_HASH=

# ==============================================================================
# 5. PHASE 8 — GEMINI CONVERSATIONAL ASSISTANT (SERVER-SIDE ONLY)
# ==============================================================================
# Google Gemini API Key (Never expose to frontend / NEXT_PUBLIC_*)
# If unconfigured, the assistant fails gracefully with 503 without crashing the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=2048

# ==============================================================================
# 6. PHASE 10 — n8n WORKFLOW AUTOMATION (SERVER-SIDE ONLY)
# ==============================================================================
# Outbound webhook destination for n8n orchestrator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/swasthyasetu-events
# HMAC-SHA256 Secret for signing outbound webhooks & verifying inbound callbacks
N8N_WEBHOOK_SECRET=swasthyasetu-prod-automation-key-2026

# ==============================================================================
# 7. PHASE 11 — SARVAM AI + EXOTEL VOICE / CALL ASSIST (SERVER-SIDE ONLY)
# ==============================================================================
# Sarvam AI API Key for Multilingual STT / TTS (Never expose to frontend)
# If unconfigured, voice AI falls back gracefully without crashing the server.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=roopa
SARVAM_TIMEOUT_MS=10000

# Exotel Telephony Credentials & Caller ID (Never expose to frontend)
# If unconfigured, telephony operations degrade safely with 503 status.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_BASE_URL=https://api.exotel.com
EXOTEL_VIRTUAL_NUMBER=
EXOTEL_CALLER_ID=

# Voice Engine Controls
VOICE_ENABLED=true
VOICE_PROVIDER_MODE=real
VOICE_MAX_TURNS=10
VOICE_MAX_CALL_DURATION_SEC=300

# ==============================================================================
# 8. FUTURE PHASE VARIABLES (PHASE 12+)
# ==============================================================================
# SWYTCHCODE_API_KEY=

